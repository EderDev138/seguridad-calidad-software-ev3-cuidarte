        {
          "name": "POST /pacientes · alta de una ficha nueva",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera un RUT chileno valido y distinto en cada corrida.",
                  "// El dominio verifica el digito, de modo que un numero al azar",
                  "// seria rechazado con 400 y la prueba fallaria por el dato y no",
                  "// por el comportamiento del sistema.",
                  "const cuerpo = String(10000000 + Math.floor(Math.random() * 9000000));",
                  "const serie = [2, 3, 4, 5, 6, 7];",
                  "let suma = 0;",
                  "for (let i = 0; i < cuerpo.length; i += 1) {",
                  "  suma += Number(cuerpo[cuerpo.length - 1 - i]) * serie[i % serie.length];",
                  "}",
                  "const resto = 11 - (suma % 11);",
                  "const digito = resto === 11 ? '0' : resto === 10 ? 'K' : String(resto);",
                  "pm.collectionVariables.set('rut_nuevo', `${cuerpo}-${digito}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CP-API-07 · HTTP 201', () => pm.response.to.have.status(201));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('CP-API-07 · devuelve el identificador asignado', () => pm.expect(cuerpo.id).to.be.a('number'));",
                  "pm.test('CP-API-07 · conserva el RUT enviado', () => pm.expect(cuerpo.rut).to.eql(pm.collectionVariables.get('rut_nuevo')));",
                  "pm.collectionVariables.set('paciente_id', cuerpo.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut\": \"{{rut_nuevo}}\",\n  \"nombres\": \"Paciente\",\n  \"apellidos\": \"Automatizacion EP3\",\n  \"fechaNacimiento\": \"1990-03-21\",\n  \"telefono\": \"+56955555555\"\n}"
            },
            "url": { "raw": "{{api}}/pacientes", "host": ["{{api}}"], "path": ["pacientes"] }
          }
        },
